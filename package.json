{
  "name": "eyedot",
  "version": "0.15.1",
  "type": "module",
  "description": "把上传的学习材料变成可自动判分的自助考试：出题交给 LLM，判定交给可替换的判定引擎（默认通用大模型，可切到 TypeSafe Jev 决策模型），报告与覆盖率可逐条核对。",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "ai-agent",
    "mcp",
    "llm-evaluation",
    "jev",
    "decision-model",
    "exam-prep",
    "education"
  ],
  "homepage": "https://www.simon-zj.top/tech/tools/eyedot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simon-zj1/eyedot.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "eyedot": "./bin/eyedot.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "examples",
    "drizzle",
    "docs/demo",
    "docs/benchmark.md",
    "docs/brand",
    "docs/marketing",
    "docs/benchmark-results.json",
    "eval/golden",
    "skills",
    "docs/banner.svg",
    "docs/architecture.md",
    "SKILL.md",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "tsconfig.json",
    "next.config.ts",
    "drizzle.config.ts",
    ".env.example"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "healthcheck": "node scripts/check-production.mjs",
    "set:typesafe-key": "node scripts/set-vercel-secret.mjs",
    "eval:judge": "tsx scripts/eval-judge.ts",
    "benchmark": "tsx scripts/eval-judge.ts --engine offline --json docs/benchmark-results.json",
    "feedback:golden": "tsx scripts/export-feedback.ts",
    "study": "tsx scripts/study.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "demo:report": "tsx scripts/study.ts demo --out docs/demo",
    "brand:icons": "node scripts/render-brand-icons.mjs",
    "credits:issue": "tsx scripts/issue-credits.ts",
    "publish:npm": "node scripts/publish-npm.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "schema:check": "tsx scripts/check-schema.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "mammoth": "^1.12.3",
    "next": "15.5.25",
    "pdfjs-dist": "^6.3.289",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
